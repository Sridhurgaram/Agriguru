# ==========================================
# AgriGuru Environment Configuration Template
# Copy this file to .env and insert real values
# ==========================================

# Flask Environment
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=replace-with-a-secure-random-secret-key-for-production

# Weather API Credentials
# Sign up at https://www.tomorrow.io/weather-api/ to get a free API key
TOMORROW_API_KEY=your_tomorrow_io_api_key_here

# 2Factor SMS Gateway
# Sign up at https://2factor.in/ to get an API key
TWO_FACTOR_API_KEY=your_2factor_api_key_here

# SQLite Database Location (defaults to agriguru.db in workspace root)
DATABASE_PATH=agriguru.db
